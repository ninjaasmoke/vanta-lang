module main

struct Stack {
    data: *int
    size: int
    capacity: int

    @debug @invariant(size <= capacity)
}

@debug @requires(s != null)
@debug @requires(s.size < s.capacity)
@debug @ensures(s.size == old(s.size) + 1)
fn push(s: *Stack, v: int) {
    s.data[s.size] = v;
    s.size += 1;
}

fn main() -> int {
    s := Stack {
        data = alloc_array(int, 10),
        size = 0,
        capacity = 10
    };

    push(&s, 42);

    free(s.data);

    return 0;
}
