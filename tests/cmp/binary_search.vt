module main;

// Binary search on a sorted array.
//
// Compare to binary_search.c. Two differences worth noting:
//
//   * The precondition `n >= 0` is part of the function's signature,
//     not a hand-rolled `assert(...)` in the body. Under --debug it
//     runs; under --release it's gone. No #ifdef NDEBUG dance.
//
//   * The postcondition documents what callers can rely on (we either
//     return -1 or an index in range). It's checked under --debug too.
//
// Verdict: Vanta wins. The contract is machine-checked, not just a
// comment that goes stale the first time someone refactors the body.
//
// exit code = index of 7 in {1,3,5,7,9,11} = 3.

@requires(n >= 0)
@ensures(result == 0 - 1 || (result >= 0 && result < n))
fn bsearch(a: *int, n: int, target: int) -> int {
    low := 0;
    high := n;
    while low < high {
        mid := low + (high - low) / 2;       // same overflow-safe split
        if a[mid] == target {
            return mid;
        }
        if a[mid] < target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return 0 - 1;
}

fn main() -> int {
    a := alloc_array(int, 6);
    a[0] = 1;
    a[1] = 3;
    a[2] = 5;
    a[3] = 7;
    a[4] = 9;
    a[5] = 11;

    r := bsearch(a, 6, 7);
    free(a);
    return r;                 // 3
}
