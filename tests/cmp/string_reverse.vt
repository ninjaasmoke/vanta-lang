module main;

// Reverse a string in place.
//
// Now a fair fight against string_reverse.c (for a while it was a
// rout - see git history, we used to fake strings with int arrays).
//
//   * `s := "hello";` allocates a fresh mutable *u8 of length 5.
//   * `s[i]` reads/writes a byte, just like char in C.
//   * `'o' == 111` because character literals are bytes.
//
// The one thing C still has on us is `strlen`. We pass the length
// in by hand. Honestly that's what a careful C programmer does
// anyway - strlen-on-every-call is a known footgun.
//
// Returns the ASCII value of the new first char ('o' = 111).

@requires(n >= 0)
fn reverse(s: *u8, n: int) {
    i := 0;
    while i < n / 2 {
        t := s[i];
        s[i] = s[n - 1 - i];
        s[n - 1 - i] = t;
        i = i + 1;
    }
}

fn main() -> int {
    s := "hello";
    reverse(s, 5);
    return s[0];          // 'o' = 111
}
