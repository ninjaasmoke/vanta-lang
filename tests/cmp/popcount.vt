module main;

// Population count: number of 1-bits in an integer.
//
// Brian Kernighan's trick: `x & (x - 1)` strips the lowest 1.
// Same as the C version, character for character.
//
// Now that vanta has bitwise ops this is no longer embarrassing.
// (The git history of this file is its own joke.)
//
// Expected result: same total as popcount.c = 24.

@requires(x >= 0)
fn popcount(x: int) -> int {
    c := 0;
    while x != 0 {
        x = x & (x - 1);
        c = c + 1;
    }
    return c;
}

fn main() -> int {
    total := 0;
    total = total + popcount(0xFF);
    total = total + popcount(0xF0);
    total = total + popcount(0x0F);
    total = total + popcount(0x00);
    total = total + popcount(0xAA);
    total = total + popcount(0x55);
    return total;                     // 24
}
