module main;

// Variant dispatch - the actual point of it.
//
// Two `trace` functions, same name, same signature, completely
// different bodies. You CANNOT express this with a single body +
// @debug @ensures: the bodies do different things (println vs
// nothing) - they have different side effects, not different
// contracts.
//
// Sema picks one variant per call site based on --attr. The
// non-selected variant is never lowered into the IR.
//
// The C equivalent is `#ifdef NDEBUG` macro piles. Vanta makes it
// two function definitions and lets the resolver figure it out.
//
// What you see:
//
//   $ ./vanta run --debug   tests/showcase/variant_dispatch.vt
//   trace 10
//   trace 20
//   trace 30
//   30
//
//   $ ./vanta run --release tests/showcase/variant_dispatch.vt
//   (no output)
//   30
//
// Same exit code. Different observed behavior. The release binary
// literally has no `println` instructions in it.

@debug
fn trace(v: int) -> int {
    print("trace ");
    println(v);
    return v;
}

@release
fn trace(v: int) -> int {
    return v;
}

fn main() -> int {
    a := trace(10);
    b := trace(20);
    return trace(a + b);   // 30 either way
}
